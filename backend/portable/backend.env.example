# PostgreSQL connection used by the local backend. Do not commit a real password.
DATABASE_URL=postgresql://oral_training_app:<password>@127.0.0.1:5432/oral_training

# The server reads this value; never put it in Mini Program source code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Allow the development-only home-page key input to configure this process in memory.
ALLOW_RUNTIME_API_KEY=true
BIND_ADDRESS=127.0.0.1
PORT=8080

# Restart the backend after changing gates. Existing v2 sessions always remain grounded.
RAG_ROLEPLAY_ENABLED=false
RAG_PATIENT_ENABLED=false
RAG_EVALUATION_V2_ENABLED=false
# Patient creation requires both PATIENT and EVALUATION_V2. 0 = uncapped normal operation.
# Controlled smoke must set a positive cap (e.g. 16); retries consume the same process-wide cap.
MODEL_CALL_LIMIT=0
