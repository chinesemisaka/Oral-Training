/* pages/result/result.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 50rpx;
}

/* 得分卡片 */
.score-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  margin: 40rpx auto;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.score-card.pass {
  background: linear-gradient(135deg, #52c41a, #389e0d);
}

.score-card.fail {
  background: linear-gradient(135deg, #ff4d4f, #cf1322);
}

.score-value {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
}

.score-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}

/* 评价 */
.evaluation {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.evaluation-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

/* 雷达图区域 */
.radar-section {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  text-align: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #007aff;
}

.radar-canvas {
  width: 500rpx;
  height: 500rpx;
  margin: 0 auto;
}

/* 详细得分 */
.scores-section {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.score-item {
  margin-bottom: 30rpx;
}

.score-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.score-name {
  font-size: 28rpx;
  color: #333;
}

.score-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #007aff;
}

.score-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

/* 按钮区域 */
.action-buttons {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.btn-primary {
  background: #007aff;
  color: #fff;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666;
}

.btn-outline {
  background: #fff;
  color: #007aff;
  border: 2rpx solid #007aff;
  line-height: 76rpx;
}