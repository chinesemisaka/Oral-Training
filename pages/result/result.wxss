.result-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.score-card {
  display: flex;
  width: 220rpx;
  height: 220rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 12rpx auto 28rpx;
  border-radius: 50%;
  color: #fff;
  box-shadow: 0 14rpx 32rpx rgba(35, 58, 88, 0.16);
}

.score-card.pass {
  background: linear-gradient(135deg, #38b778, #168e5a);
}

.score-card.fail {
  background: linear-gradient(135deg, #ed7777, #d94f58);
}

.score-value {
  font-size: 68rpx;
  font-weight: 700;
}

.score-label {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.section-card,
.status-card,
.error-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #fff;
}

.section-title,
.status-title {
  display: block;
  margin-bottom: 18rpx;
  color: #26364a;
  font-size: 31rpx;
  font-weight: 700;
}

.summary-text,
.status-desc,
.error-card {
  color: #67778c;
  font-size: 27rpx;
  line-height: 1.7;
}

.transcript-item {
  display: flex;
  flex-direction: column;
  max-width: 88%;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #35465b;
  background: #f5f8fc;
  font-size: 26rpx;
  line-height: 1.6;
}

.transcript-user {
  margin-left: auto;
  background: #e8f2ff;
}

.transcript-role {
  color: #1677e8;
  font-size: 23rpx;
  font-weight: 600;
}

.transcript-content {
  margin-top: 4rpx;
}

.transcript-time {
  margin-top: 6rpx;
  color: #8b99aa;
  font-size: 21rpx;
  text-align: right;
}

.radar-section {
  text-align: center;
}

.radar-canvas {
  width: 520rpx;
  height: 480rpx;
  margin: 0 auto;
}

.dimension-list {
  text-align: left;
}

.dimension-item {
  margin-top: 20rpx;
}

.dimension-head {
  display: flex;
  justify-content: space-between;
  color: #4b5b70;
  font-size: 25rpx;
}

.dimension-score {
  color: #1677e8;
  font-weight: 600;
}

.score-bar {
  height: 14rpx;
  margin-top: 10rpx;
  overflow: hidden;
  background: #edf1f6;
  border-radius: 7rpx;
}

.score-fill {
  height: 100%;
  border-radius: 7rpx;
}

.feedback-item,
.violation-item {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
  padding: 18rpx;
  color: #4b5b70;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.feedback-round,
.violation-type {
  color: #1677e8;
  font-size: 23rpx;
  font-weight: 600;
}

.feedback-evidence,
.rewrite {
  margin-top: 8rpx;
  color: #718096;
  font-size: 24rpx;
}

.improvement {
  background: #fffaf0;
}

.danger-title,
.violation-type {
  color: #d94f58;
}

.violation-item {
  background: #fff5f5;
}

.quote {
  margin-top: 10rpx;
  color: #26364a;
  font-weight: 600;
}

.reason {
  margin-top: 8rpx;
}

.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #67778c;
  text-align: center;
  font-size: 27rpx;
}

.failed-card {
  align-items: stretch;
  color: #c84b4b;
}

.loading-dot {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 18rpx;
  border: 5rpx solid #dbe9fa;
  border-top-color: #1677e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}

.primary-button,
.secondary-button,
.outline-button {
  width: 100%;
  height: 76rpx;
  margin: 0;
  border-radius: 38rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.primary-button {
  color: #fff;
  background: #1677e8;
}

.secondary-button {
  color: #4b5b70;
  background: #e9eef5;
}

.outline-button {
  color: #1677e8;
  background: #fff;
  border: 2rpx solid #1677e8;
  line-height: 72rpx;
}

.primary-button::after,
.secondary-button::after,
.outline-button::after {
  border: none;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
