.training-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  background: #f5f7fb;
}

.session-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: #1677e8;
}

.session-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 20rpx;
}

.scenario-name {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.patient-profile,
.round-text {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 23rpx;
  line-height: 1.5;
}

.finish-button {
  height: 60rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #1677e8;
  background: #fff;
  border-radius: 30rpx;
  font-size: 23rpx;
  line-height: 60rpx;
}

.finish-button::after {
  border: none;
}

.chat-area {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.message-item,
.typing-state {
  display: flex;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.user-message {
  flex-direction: row-reverse;
}

.message-avatar {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #1677e8;
  background: #dcecff;
  border-radius: 50%;
  font-size: 24rpx;
}

.user-message .message-avatar {
  color: #fff;
  background: #1677e8;
}

.message-body {
  max-width: 75%;
  margin: 0 16rpx;
}

.user-message .message-body {
  text-align: right;
}

.message-bubble {
  padding: 18rpx 22rpx;
  color: #26364a;
  background: #fff;
  border-radius: 18rpx;
  text-align: left;
}

.user-message .message-bubble {
  color: #fff;
  background: #1677e8;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.message-time {
  display: block;
  margin-top: 8rpx;
  color: #9aa7b7;
  font-size: 20rpx;
}

.typing-state {
  align-items: center;
  color: #8a97a8;
  font-size: 24rpx;
}

.typing-state .message-avatar {
  margin-right: 16rpx;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
  background: #fff;
  border-top: 1rpx solid #e8edf3;
}

.input-field {
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  color: #26364a;
  background: #f3f6fa;
  border-radius: 36rpx;
  font-size: 27rpx;
}

.send-button {
  width: 120rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  background: #1677e8;
  border-radius: 36rpx;
  font-size: 27rpx;
  line-height: 72rpx;
}

.send-button::after {
  border: none;
}

.send-button[disabled],
.finish-button[disabled] {
  opacity: 0.55;
}

.error-panel {
  margin: 24rpx;
  padding: 24rpx;
  color: #c84b4b;
  background: #fff1f1;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.end-loading {
  padding: 30rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  color: #66778c;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
}
