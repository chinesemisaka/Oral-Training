/* pages/training/training.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 患者卡片 */
.patient-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
}

.patient-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
}

.patient-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.patient-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.patient-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.remaining-turns {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.level-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

/* 聊天区域 */
.chat-area {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.user-message {
  flex-direction: row-reverse;
}

.user-message .message-bubble {
  background-color: #007aff;
  color: #fff;
  margin-right: 20rpx;
  margin-left: 0;
}

.ai-message .message-bubble {
  background-color: #fff;
  color: #333;
  margin-left: 20rpx;
  border: 1rpx solid #e0e0e0;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-bubble {
  max-width: 500rpx;
  padding: 20rpx 25rpx;
  border-radius: 20rpx;
  word-wrap: break-word;
  position: relative;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.5;
}

.message-time {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.4);
  margin-top: 10rpx;
  text-align: right;
}

.user-message .message-time {
  color: rgba(255, 255, 255, 0.6);
}

/* 黄金话术推荐 */
.suggestions-bar {
  background: #fff;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
}

.suggestions-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fafafa;
}

.suggestions-title {
  font-size: 26rpx;
  color: #fa8c16;
}

.suggestions-arrow {
  font-size: 24rpx;
  color: #999;
}

.suggestions-list {
  padding: 20rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}

.suggestion-item {
  background: #f0f7ff;
  padding: 15rpx 25rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #007aff;
  border: 1rpx solid #d9e8ff;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  gap: 20rpx;
}

.voice-btn image {
  width: 50rpx;
  height: 50rpx;
}

.input-field {
  flex: 1;
  height: 70rpx;
  padding: 0 25rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #007aff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 35rpx;
  padding: 0;
  margin: 0;
}

.send-btn[disabled] {
  background-color: #ccc;
}

/* 结束加载 */
.end-loading {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.85);
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #fff;
  font-size: 28rpx;
  z-index: 100;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}