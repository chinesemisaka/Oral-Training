<view class="training-page">
  <view class="session-header">
    <view class="session-copy">
      <text class="scenario-name">{{scenarioName}}</text>
      <text class="patient-profile">{{patientProfile || 'AI 模拟患者正在准备中'}}</text>
      <text class="round-text">第 {{currentRound}} / {{maxRounds}} 轮 · 剩余 {{remainingRounds}} 轮</text>
    </view>
    <button
      wx:if="{{!isTrainingEnd}}"
      class="finish-button"
      data-reason="manual"
      bindtap="finishTraining"
      disabled="{{sending || finishing}}"
    >结束训练</button>
  </view>

  <view wx:if="{{errorMessage}}" class="error-panel">
    <text>{{errorMessage}}</text>
  </view>

  <scroll-view
    wx:if="{{!errorMessage}}"
    class="chat-area"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="message-item {{item.role === 'user' ? 'user-message' : 'patient-message'}}" wx:for="{{messages}}" wx:key="id">
      <view class="message-avatar">{{item.role === 'user' ? '我' : '患'}}</view>
      <view class="message-body">
        <view class="message-bubble">
          <text class="message-content">{{item.content}}</text>
        </view>
        <text class="message-time">{{item.createdAt}}</text>
      </view>
    </view>
    <view wx:if="{{sending}}" class="typing-state">
      <text class="message-avatar">患</text>
      <text>患者正在输入…</text>
    </view>
    <view id="msg-bottom"></view>
  </scroll-view>

  <view wx:if="{{!isTrainingEnd && !errorMessage}}" class="input-area">
    <input
      class="input-field"
      placeholder="输入你的回复..."
      value="{{inputValue}}"
      bindinput="onInputChange"
      confirm-type="send"
      bindconfirm="sendMessage"
      disabled="{{sending || finishing}}"
    />
    <button class="send-button" bindtap="sendMessage" disabled="{{sending || finishing}}">发送</button>
  </view>

  <view wx:if="{{isTrainingEnd}}" class="end-loading">
    <text>训练已结束，正在生成评分报告…</text>
  </view>
</view>
