<!-- pages/admin/admin.wxml -->
<view class="container">
  
  <!-- 数据概览卡片 -->
  <view class="summary-cards">
    <view class="summary-card">
      <text class="summary-value">{{summary.totalUsers}}</text>
      <text class="summary-label">总学员数</text>
    </view>
    <view class="summary-card">
      <text class="summary-value">{{summary.totalTrainings}}</text>
      <text class="summary-label">总训练次数</text>
    </view>
    <view class="summary-card">
      <text class="summary-value">{{summary.avgScore}}</text>
      <text class="summary-label">平均分</text>
    </view>
    <view class="summary-card">
      <text class="summary-value">{{summary.activeUsers}}</text>
      <text class="summary-label">活跃人数</text>
    </view>
  </view>

  <!-- 日期切换 -->
  <view class="date-tabs">
    <view class="date-tab {{dateRange === 'week' ? 'active' : ''}}" bindtap="onDateRangeChange" data-range="week">本周</view>
    <view class="date-tab {{dateRange === 'month' ? 'active' : ''}}" bindtap="onDateRangeChange" data-range="month">本月</view>
    <view class="date-tab {{dateRange === 'quarter' ? 'active' : ''}}" bindtap="onDateRangeChange" data-range="quarter">本季</view>
  </view>

  <!-- 训练趋势图 -->
  <view class="chart-card">
    <view class="card-title">训练趋势</view>
    <canvas type="2d" id="dailyChart" class="daily-chart"></canvas>
  </view>

  <!-- 团队排名 -->
  <view class="ranking-card">
    <view class="card-title">团队排名 TOP5</view>
    <view class="ranking-list">
      <view class="ranking-item" wx:for="{{teamRanking}}" wx:key="name" bindtap="viewMemberDetail" data-member="{{item}}">
        <view class="ranking-num rank-{{index + 1}}">{{index + 1}}</view>
        <image class="ranking-avatar" src="{{item.avatar || '/static/images/default-avatar.png'}}"></image>
        <view class="ranking-info">
          <text class="ranking-name">{{item.name}}</text>
          <text class="ranking-trainings">{{item.trainings}}次训练</text>
        </view>
        <view class="ranking-score">{{item.score}}分</view>
      </view>
    </view>
  </view>

  <!-- 违规词统计 -->
  <view class="redflag-card">
    <view class="card-title">高频违规词</view>
    <view class="redflag-list">
      <view class="redflag-item" wx:for="{{redFlagStats}}" wx:key="word">
        <text class="redflag-word">⚠️ {{item.word}}</text>
        <text class="redflag-count">{{item.count}}次</text>
      </view>
    </view>
  </view>

<!-- 关卡统计部分 - 修复后 -->
<view class="level-card">
  <view class="card-title">关卡通过率</view>
  <view class="level-stats">
    <view class="level-stat-item" wx:for="{{levelStats}}" wx:key="name">
      <view class="level-stat-header">
        <text class="level-stat-name">{{item.name}}</text>
        <text class="level-stat-rate">{{item.passRate}}%</text>
      </view>
      <view class="level-stat-bar">
        <!-- 修复这一行 -->
        <view class="level-stat-fill" style="width: {{item.passRate + '%'}}"></view>
      </view>
      <text class="level-stat-score">平均分: {{item.avgScore}}</text>
    </view>
  </view>
</view>

  <!-- 底部按钮 -->
  <view class="bottom-btn">
    <button class="export-btn" bindtap="exportData">导出数据报表</button>
  </view>
</view>