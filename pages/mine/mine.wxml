<view class="dashboard-page">
  <view class="page-intro">
    <text class="page-title">演示数据</text>
    <text class="page-desc">固定演示用户的训练数据汇总，不包含团队权限和排行榜。</text>
  </view>

  <view wx:if="{{errorMessage}}" class="error-card">
    <text>{{errorMessage}}</text>
    <button bindtap="loadDashboard">重新加载</button>
  </view>

  <block wx:if="{{summary && !errorMessage}}">
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{summary.totalSessions}}</text>
        <text class="stat-label">总训练次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{summary.completedSessions}}</text>
        <text class="stat-label">已完成次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{summary.averageScore}}</text>
        <text class="stat-label">平均得分</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">场景训练次数</text>
      <view class="scenario-row" wx:for="{{summary.scenarioStats}}" wx:key="scenarioId">
        <text class="scenario-name">{{item.scenarioName}}</text>
        <text class="scenario-count">{{item.trainingCount}} 次</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">五维平均得分</text>
      <view class="dimension-row" wx:for="{{summary.dimensions}}" wx:key="name">
        <view class="dimension-head">
          <text>{{item.name}}</text>
          <text class="dimension-score">{{item.value}}分</text>
        </view>
        <view class="score-bar">
          <view class="score-fill" style="width: {{item.value}}%;"></view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">最近训练</text>
      <view class="recent-row" wx:for="{{summary.recentSessions}}" wx:key="id">
        <view class="recent-copy">
          <text>{{item.scenarioName}}</text>
          <text class="recent-time">{{item.updatedAt}}</text>
        </view>
        <text class="recent-score" wx:if="{{item.totalScore !== null && item.totalScore !== undefined}}">{{item.totalScore}}分</text>
      </view>
      <text wx:if="{{summary.recentSessions.length === 0}}" class="empty-tip">暂无训练记录</text>
    </view>
  </block>

  <view wx:if="{{loading}}" class="loading-state">加载演示数据中...</view>

  <view class="action-row">
    <button class="primary-button" bindtap="goTraining">去训练</button>
    <button class="secondary-button" bindtap="goHistory">查看历史</button>
  </view>
</view>
