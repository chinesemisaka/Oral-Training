<!-- pages/mine/mine.wxml -->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <image class="avatar" src="{{userInfo.avatar || '/static/images/default-avatar.png'}}"></image>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname || '口腔客服'}}</text>
        <text class="title">{{userInfo.title || '初级客服'}}</text>
      </view>
      <view class="edit-btn" bindtap="editProfile">
        <text>编辑</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{userInfo.level || 1}}</text>
        <text class="stat-label">等级</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.totalTrainings || 0}}</text>
        <text class="stat-label">训练次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.rank || 0}}</text>
        <text class="stat-label">排名</text>
      </view>
    </view>

    <!-- 连续打卡 & 打卡按钮 -->
    <view class="checkin-row">
      <text class="checkin-icon">🔥</text>
      <text class="checkin-text">连续打卡 {{stats.continuousDays || 0}} 天</text>
      <view class="checkin-btn {{todayChecked ? 'checked' : ''}}" bindtap="doCheckIn">
        <text>{{todayChecked ? '已打卡' : '打卡'}}</text>
      </view>
    </view>
  </view>

  <!-- 打卡日历 -->
  <view class="calendar-card">
    <view class="calendar-header">
      <text class="calendar-arrow" bindtap="prevMonth">‹</text>
      <text class="calendar-title">{{calendar.year}}年{{calendar.month}}月</text>
      <text class="calendar-arrow" bindtap="nextMonth">›</text>
    </view>
    <view class="calendar-weekdays">
      <text class="weekday">日</text>
      <text class="weekday">一</text>
      <text class="weekday">二</text>
      <text class="weekday">三</text>
      <text class="weekday">四</text>
      <text class="weekday">五</text>
      <text class="weekday">六</text>
    </view>
    <view class="calendar-days">
      <view
        class="day-cell {{item.isEmpty ? 'empty' : ''}} {{item.isToday ? 'today' : ''}} {{item.checked ? 'checked' : ''}}"
        wx:for="{{calendar.days}}"
        wx:key="index"
      >
        <text wx:if="{{!item.isEmpty}}">{{item.day}}</text>
        <view wx:if="{{item.checked}}" class="day-dot"></view>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="name" bindtap="onMenuTap" data-url="{{item.url}}">
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
      </view>
      <text class="menu-arrow" wx:if="{{item.arrow}}">›</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <view class="footer-links">
      <text bindtap="aboutUs">关于我们</text>
      <text>|</text>
      <text bindtap="contactService">联系客服</text>
    </view>
    <view class="version" wx:if="{{showVersion}}">
      <text>版本 v1.0.0</text>
    </view>
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>