.dashboard-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.page-intro {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.page-title {
  color: #26364a;
  font-size: 44rpx;
  font-weight: 700;
}

.page-desc {
  margin-top: 12rpx;
  color: #718096;
  font-size: 26rpx;
  line-height: 1.5;
}

.stats-grid {
  display: flex;
  gap: 14rpx;
}

.stat-card,
.section-card,
.error-card {
  background: #fff;
  border-radius: 22rpx;
}

.stat-card {
  display: flex;
  flex: 1;
  min-height: 150rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-value {
  color: #1677e8;
  font-size: 42rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 10rpx;
  color: #8a97a8;
  font-size: 22rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #26364a;
  font-size: 30rpx;
  font-weight: 700;
}

.scenario-row,
.recent-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.scenario-row:last-child,
.recent-row:last-child {
  border-bottom: none;
}

.scenario-name,
.recent-copy {
  color: #4b5b70;
  font-size: 26rpx;
}

.scenario-count,
.recent-score {
  color: #1677e8;
  font-size: 25rpx;
  font-weight: 600;
}

.dimension-row {
  margin-top: 18rpx;
}

.dimension-head {
  display: flex;
  justify-content: space-between;
  color: #4b5b70;
  font-size: 25rpx;
}

.dimension-score {
  color: #1677e8;
  font-weight: 600;
}

.score-bar {
  height: 14rpx;
  margin-top: 10rpx;
  overflow: hidden;
  background: #edf1f6;
  border-radius: 7rpx;
}

.score-fill {
  height: 100%;
  background: #1677e8;
  border-radius: 7rpx;
}

.recent-copy {
  display: flex;
  flex-direction: column;
}

.recent-time {
  margin-top: 8rpx;
  color: #9aa7b7;
  font-size: 21rpx;
}

.empty-tip,
.loading-state {
  display: block;
  padding: 50rpx 0 20rpx;
  color: #8a97a8;
  text-align: center;
  font-size: 25rpx;
}

.error-card {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  color: #c84b4b;
  font-size: 26rpx;
}

.error-card button {
  align-self: flex-start;
  height: 60rpx;
  margin: 18rpx 0 0;
  padding: 0 20rpx;
  color: #fff;
  background: #e05a5a;
  border-radius: 30rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.error-card button::after {
  border: none;
}

.action-row {
  display: flex;
  margin-top: 24rpx;
  gap: 14rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
  height: 72rpx;
  margin: 0;
  border-radius: 36rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.primary-button {
  color: #fff;
  background: #1677e8;
}

.secondary-button {
  color: #4b5b70;
  background: #e9eef5;
}

.primary-button::after,
.secondary-button::after {
  border: none;
}
