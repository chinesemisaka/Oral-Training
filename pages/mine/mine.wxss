/* pages/mine/mine.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #007aff, #00c6fb);
  margin: 20rpx;
  padding: 40rpx 30rpx;
  border-radius: 32rpx;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 25rpx;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  background: #fff;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.edit-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 25rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
}

/* 统计数据 */
.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 打卡 */
.checkin-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 15rpx;
  border-radius: 50rpx;
}

.checkin-icon {
  font-size: 32rpx;
}

.checkin-text {
  font-size: 26rpx;
  color: #fff;
  flex: 1;
}

.checkin-btn {
  background: #fff;
  color: #007aff;
  font-size: 26rpx;
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
  font-weight: bold;
}

.checkin-btn.checked {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
}

/* 打卡日历 */
.calendar-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.calendar-arrow {
  font-size: 40rpx;
  color: #007aff;
  padding: 0 20rpx;
  font-weight: bold;
}

.calendar-weekdays {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #333;
  position: relative;
}

.day-cell.empty {
  visibility: hidden;
}

.day-cell.today {
  color: #007aff;
  font-weight: bold;
}

.day-cell.today::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #007aff;
}

.day-cell.checked {
  color: #007aff;
  font-weight: bold;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #52c41a;
  position: absolute;
  bottom: 6rpx;
}

.day-cell.today.checked::after {
  display: none;
}

/* 菜单列表 */
.menu-list {
  background: #fff;
  margin: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 25rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-name {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 30rpx 60rpx;
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.version {
  font-size: 24rpx;
  color: #ccc;
  margin-bottom: 30rpx;
}

.logout-btn {
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin: 0 auto;
}