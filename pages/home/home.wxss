.home-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.hero-card {
  display: flex;
  flex-direction: column;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0b77e3, #5b8def);
  box-shadow: 0 16rpx 40rpx rgba(25, 105, 205, 0.2);
}

.eyebrow {
  margin-bottom: 18rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  line-height: 1.7;
}

.primary-button {
  width: 100%;
  margin: 34rpx 0 0;
  color: #176fd3;
  background: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.primary-button::after {
  border: none;
}

.demo-notice,
.boundary-card {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #fff;
}

.notice-title,
.boundary-title {
  color: #26364a;
  font-size: 30rpx;
  font-weight: 600;
}

.notice-desc,
.boundary-text {
  margin-top: 12rpx;
  color: #718096;
  font-size: 25rpx;
  line-height: 1.6;
}

.entry-list {
  margin-top: 24rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
}

.entry-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  color: #1677e8;
  background: #eaf3ff;
  border-radius: 20rpx;
  font-size: 38rpx;
}

.entry-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 20rpx;
}

.entry-title {
  color: #26364a;
  font-size: 30rpx;
  font-weight: 600;
}

.entry-desc {
  margin-top: 8rpx;
  color: #8a97a8;
  font-size: 24rpx;
}

.entry-arrow {
  color: #aab5c4;
  font-size: 44rpx;
}
