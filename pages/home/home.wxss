/* pages/home/home.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 大标题 */
.hero-title {
  padding: 60rpx 24rpx 30rpx;
  text-align: center;
}

.hero-title-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 4rpx;
}

/* 去训练按钮 */
.train-btn-wrap {
  padding: 0 60rpx 30rpx;
}

.train-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #007aff, #00c6fb);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.3);
  padding: 0;
}

.train-btn::after {
  border: none;
}

/* 模块通用 */
.section {
  padding: 10rpx 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 话术列表 */
.script-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.script-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.script-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.script-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.script-difficulty {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.script-difficulty.easy {
  background: #e6f7e6;
  color: #52c41a;
}

.script-difficulty.medium {
  background: #fff7e6;
  color: #fa8c16;
}

.script-difficulty.hard {
  background: #ffe6e6;
  color: #f5222d;
}

.script-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.script-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.script-tag {
  font-size: 22rpx;
  color: #007aff;
  background: #e6f2ff;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.script-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.script-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
}

.script-category-badge {
  font-size: 22rpx;
  color: #007aff;
  background: #f0f7ff;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 示范对话 */
.script-dialogue {
  margin: 16rpx 0;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.dialogue-round {
  margin-bottom: 16rpx;
}

.dialogue-round:last-child {
  margin-bottom: 0;
}

.dialogue-bubble {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dialogue-bubble.patient {
  align-items: flex-start;
}

.dialogue-bubble.service {
  align-items: flex-end;
}

.dialogue-role {
  font-size: 22rpx;
  color: #999;
}

.dialogue-bubble.patient .dialogue-text {
  background: #fff;
  border-radius: 0 16rpx 16rpx 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  max-width: 85%;
}

.dialogue-bubble.service .dialogue-text {
  background: #e6f2ff;
  border-radius: 16rpx 0 16rpx 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  max-width: 85%;
}

.script-expand-hint {
  font-size: 22rpx;
  color: #007aff;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}