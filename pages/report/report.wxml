<view class="history-page">
  <view class="page-intro">
    <text class="page-title">历史记录</text>
    <text class="page-desc">查看训练状态、对话记录和评分报告。</text>
  </view>

  <view class="filter-bar">
    <view class="filter-item {{statusFilter === 'all' ? 'active' : ''}}" data-status="all" bindtap="changeFilter">全部</view>
    <view class="filter-item {{statusFilter === 'in_progress' ? 'active' : ''}}" data-status="in_progress" bindtap="changeFilter">进行中</view>
    <view class="filter-item {{statusFilter === 'completed' ? 'active' : ''}}" data-status="completed" bindtap="changeFilter">已完成</view>
    <view class="filter-item {{statusFilter === 'abandoned' ? 'active' : ''}}" data-status="abandoned" bindtap="changeFilter">已放弃</view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-card">
    <text>{{errorMessage}}</text>
    <button bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:if="{{!loading && !errorMessage}}" class="session-list">
    <view class="session-card" wx:for="{{sessions}}" wx:key="id" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="viewSession">
      <view class="session-main">
        <text class="session-name">{{item.scenarioName}}</text>
        <text class="session-time">{{item.updatedAt}}</text>
      </view>
      <view class="session-meta">
        <text class="status-tag status-{{item.status}}">{{item.status === 'in_progress' ? '进行中' : (item.status === 'completed' ? '已完成' : '已放弃')}}</text>
        <text class="round-count">{{item.currentRound}} / {{item.maxRounds}} 轮</text>
        <text wx:if="{{item.totalScore !== null && item.totalScore !== undefined}}" class="session-score">{{item.totalScore}}分</text>
        <text wx:else class="session-score muted">查看详情 ›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">加载历史记录中...</view>
  <view wx:if="{{!loading && !errorMessage && sessions.length === 0}}" class="empty-state">暂无训练记录</view>
</view>
