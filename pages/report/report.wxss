/* pages/report/report.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 能力卡片 */
.ability-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #007aff;
}

.ability-item {
  margin-bottom: 25rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ability-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
}

.ability-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.ability-fill {
  height: 100%;
  border-radius: 10rpx;
}

.ability-value {
  width: 80rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #007aff;
  text-align: right;
}

/* 标签页 */
.tab-bar {
  background: #fff;
  display: flex;
  margin: 20rpx;
  border-radius: 60rpx;
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 50rpx;
}

.tab-item.active {
  background: #007aff;
  color: #fff;
}

/* 薄弱项 */
.weakness-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.weakness-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.weakness-word {
  font-size: 28rpx;
  color: #ff4d4f;
}

.weakness-count {
  font-size: 26rpx;
  color: #999;
}

/* 推荐练习 */
.recommend-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.recommend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.recommend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.recommend-desc {
  font-size: 24rpx;
  color: #999;
}

.recommend-btn {
  height: 48rpx;
  line-height: 48rpx;
  background: #007aff;
  color: #fff;
  font-size: 22rpx;
  border-radius: 24rpx;
  margin-left: 20rpx;
  padding: 0 12rpx;
  flex-shrink: 0;
}

/* 训练历史 */
.history-list {
  background: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-level {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.history-score {
  font-size: 36rpx;
  font-weight: bold;
}

.history-score.pass {
  color: #52c41a;
}

.history-score.fail {
  color: #ff4d4f;
}

/* 错题本 */
.mistake-list {
  margin: 20rpx;
}

.mistake-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.mistake-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.mistake-scene {
  font-size: 24rpx;
  color: #fa8c16;
  background: #fff7e6;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.mistake-time {
  font-size: 24rpx;
  color: #999;
}

.mistake-content {
  background: #fafafa;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.mistake-label {
  font-size: 24rpx;
  color: #ff4d4f;
  display: block;
  margin-bottom: 10rpx;
}

.mistake-text {
  font-size: 28rpx;
  color: #333;
}

.mistake-suggestion {
  background: #e6f7e6;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.suggestion-label {
  font-size: 24rpx;
  color: #52c41a;
  display: block;
  margin-bottom: 10rpx;
}

.suggestion-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.practice-btn {
  width: 100%;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #007aff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 35rpx;
  padding: 0;
}

/* 成长轨迹 */
.progress-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.trend-canvas {
  width: 100%;
  height: 400rpx;
}

.level-progress {
  margin-top: 20rpx;
}

.progress-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 25rpx;
}

.progress-name {
  width: 160rpx;
  font-size: 26rpx;
  color: #666;
}

.progress-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #007aff;
  border-radius: 10rpx;
}

.progress-status {
  width: 80rpx;
  font-size: 24rpx;
  text-align: right;
}

/* 排行榜 */
/* 我的排名卡片 */
.rank-my-card {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rank-my-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rank-my-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.rank-my-position {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

.rank-my-stats {
  display: flex;
  gap: 40rpx;
}

.rank-my-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.rank-my-stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.rank-my-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 领奖台 - 前三名 */
.rank-podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 30rpx 20rpx 20rpx;
  gap: 20rpx;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.podium-item.first {
  transform: scale(1.1);
}

.podium-crown {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.podium-avatar-wrap {
  position: relative;
}

.podium-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #f0f0f0;
  background: #e0e0e0;
}

.podium-item.first .podium-avatar {
  width: 120rpx;
  height: 120rpx;
  border-color: #ffd700;
}

.podium-medal {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.podium-medal.gold {
  background: #ffd700;
  color: #8b6914;
}

.podium-medal.silver {
  background: #c0c0c0;
  color: #666;
}

.podium-medal.bronze {
  background: #cd7f32;
  color: #fff;
}

.podium-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.podium-score {
  font-size: 24rpx;
  color: #007aff;
  font-weight: bold;
}

/* 排行列表 */
.rank-list {
  margin: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-item.is-me {
  background: #f0f7ff;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.rank-num {
  width: 48rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #999;
  text-align: center;
}

.rank-num.top {
  color: #ff6b6b;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e0e0e0;
}

.rank-user {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.rank-nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.rank-title-badge {
  font-size: 22rpx;
  color: #007aff;
  background: #e6f2ff;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.rank-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.rank-total-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.rank-avg {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}

/* 底部按钮 */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.export-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0;
}