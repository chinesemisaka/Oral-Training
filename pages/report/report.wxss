.history-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.page-intro {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.page-title {
  color: #26364a;
  font-size: 44rpx;
  font-weight: 700;
}

.page-desc {
  margin-top: 12rpx;
  color: #718096;
  font-size: 26rpx;
}

.filter-bar {
  display: flex;
  margin-bottom: 20rpx;
  padding: 8rpx;
  background: #fff;
  border-radius: 44rpx;
}

.filter-item {
  flex: 1;
  padding: 18rpx 0;
  color: #718096;
  border-radius: 36rpx;
  font-size: 24rpx;
  text-align: center;
}

.filter-item.active {
  color: #fff;
  background: #1677e8;
}

.session-card,
.error-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #fff;
}

.session-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.session-name {
  overflow: hidden;
  color: #26364a;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  margin-top: 10rpx;
  color: #9aa7b7;
  font-size: 22rpx;
}

.session-meta {
  display: flex;
  min-width: 132rpx;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 18rpx;
  gap: 8rpx;
}

.status-tag {
  padding: 5rpx 12rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
}

.status-in_progress {
  color: #ad6b00;
  background: #fff4d6;
}

.status-completed {
  color: #188451;
  background: #e8f8ef;
}

.status-abandoned {
  color: #7f8b99;
  background: #eef1f4;
}

.round-count {
  color: #718096;
  font-size: 22rpx;
}

.session-score {
  color: #1677e8;
  font-size: 28rpx;
  font-weight: 700;
}

.session-score.muted {
  color: #9aa7b7;
  font-size: 22rpx;
  font-weight: 400;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  color: #c84b4b;
  font-size: 26rpx;
}

.error-card button {
  height: 60rpx;
  margin: 18rpx 0 0;
  padding: 0 20rpx;
  color: #fff;
  background: #e05a5a;
  border-radius: 30rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.error-card button::after {
  border: none;
}

.loading-state,
.empty-state {
  padding: 100rpx 0;
  color: #8a97a8;
  text-align: center;
  font-size: 26rpx;
}
