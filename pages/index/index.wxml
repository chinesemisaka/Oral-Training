<view class="scenario-page">
  <view class="page-intro">
    <text class="page-title">选择训练场景</text>
    <text class="page-desc">阅读患者公开画像，选择一个场景开始文字对练。</text>
  </view>

  <view wx:if="{{errorMessage}}" class="error-card">
    <text>{{errorMessage}}</text>
    <button bindtap="loadScenarios">重新加载</button>
  </view>

  <view wx:if="{{!loading && !errorMessage}}" class="scenario-list">
    <view class="scenario-card" wx:for="{{scenarios}}" wx:key="id">
      <view class="scenario-topline">
        <text class="scenario-name">{{item.name}}</text>
        <text class="difficulty">{{item.difficulty === 'advanced' ? '进阶' : '基础'}}</text>
      </view>
      <text class="scenario-summary">{{item.summary}}</text>

      <view class="profile-block">
        <text class="block-label">患者基础画像</text>
        <text class="profile-text">{{item.patientProfile.age}}岁 · {{item.patientProfile.description}}</text>
      </view>

      <view class="focus-block">
        <text class="block-label">训练重点</text>
        <view class="focus-list">
          <text class="focus-tag" wx:for="{{item.focus}}" wx:for-item="focus" wx:key="*this">{{focus}}</text>
        </view>
      </view>

      <view class="scenario-footer">
        <text class="best-score" wx:if="{{item.bestScore > 0}}">历史最佳 {{item.bestScore}} 分</text>
        <text class="best-score" wx:else>尚未训练</text>
        <view class="action-group">
          <button
            wx:if="{{item.activeSession}}"
            class="secondary-button"
            data-session-id="{{item.activeSession.id}}"
            bindtap="restartTraining"
          >重新开始</button>
          <button
            class="primary-small-button"
            data-id="{{item.id}}"
            bindtap="startTraining"
          >{{item.activeSession ? '继续训练' : '开始训练'}}</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">加载场景中...</view>
  <view wx:if="{{!loading && !errorMessage && scenarios.length === 0}}" class="empty-state">暂无可用训练场景</view>
</view>
