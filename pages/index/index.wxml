<view class="page-shell scene-page">
  <view class="scene-header">
    <text class="eyebrow">STEP 01 / SCENE</text>
    <text class="page-title">选择训练场景</text>
    <text class="page-intro">先了解患者公开画像，再开始一段不提供提示的真实对练。</text>
  </view>

  <view class="boundary-tip"><text class="boundary-icon">i</text><text>患者隐藏信息不会直接展示，训练中请通过提问逐步了解。</text></view>

  <view class="scenario-list">
    <view class="scenario-card card" wx:for="{{scenarios}}" wx:key="id">
      <view class="scenario-topline">
        <text class="scenario-index">0{{index + 1}}</text>
        <text class="difficulty {{item.difficulty === '进阶' ? 'advanced' : ''}}">{{item.difficulty}}</text>
        <text class="active-mark" wx:if="{{item.activeSession}}">进行中 · {{item.activeSession.currentRound}}/10轮</text>
      </view>
      <text class="scenario-name">{{item.name}}</text>
      <text class="scenario-summary">{{item.summary}}</text>
      <view class="profile-row">
        <view class="profile-avatar">{{item.patientAge}}</view>
        <view class="profile-copy"><text class="profile-label">患者基础画像</text><text class="profile-text">{{item.patientConcern}}，初始情绪{{item.patientEmotion}}</text></view>
      </view>
      <view class="focus-row" bindtap="toggleProfile" data-id="{{item.id}}"><text class="focus-label">训练重点</text><text class="focus-hint">{{expandedId === item.id ? '收起' : '查看'}} ›</text></view>
      <view class="focus-list" wx:if="{{expandedId === item.id}}"><text class="focus-tag" wx:for="{{item.focus}}" wx:for-item="focus" wx:key="*this">{{focus}}</text></view>
      <view class="scenario-actions">
        <button class="primary-button scenario-button" bindtap="openTraining" data-id="{{item.id}}" data-mode="{{item.activeSession ? 'continue' : 'new'}}">{{item.actionText}}</button>
        <text class="restart-link" wx:if="{{item.activeSession}}" bindtap="restartTraining" data-id="{{item.id}}">重新开始</text>
      </view>
    </view>
  </view>
  <text class="disclaimer">AI模拟训练，不构成医疗建议；客服不替代医生进行诊断或确定治疗方案。</text>
</view>
