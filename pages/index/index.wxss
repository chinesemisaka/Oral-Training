.scenario-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.page-intro {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.page-title {
  color: #26364a;
  font-size: 44rpx;
  font-weight: 700;
}

.page-desc {
  margin-top: 12rpx;
  color: #718096;
  font-size: 26rpx;
}

.scenario-card,
.error-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(35, 58, 88, 0.05);
}

.scenario-topline,
.scenario-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scenario-name {
  color: #26364a;
  font-size: 32rpx;
  font-weight: 700;
}

.difficulty {
  padding: 6rpx 16rpx;
  color: #1677e8;
  background: #eaf3ff;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.scenario-summary,
.profile-text {
  display: block;
  margin-top: 14rpx;
  color: #67778c;
  font-size: 26rpx;
  line-height: 1.6;
}

.profile-block,
.focus-block {
  margin-top: 22rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.block-label {
  color: #4b5b70;
  font-size: 24rpx;
  font-weight: 600;
}

.focus-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.focus-tag {
  padding: 6rpx 14rpx;
  color: #1677e8;
  background: #eaf3ff;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.scenario-footer {
  margin-top: 24rpx;
}

.best-score {
  color: #8a97a8;
  font-size: 24rpx;
}

.action-group {
  display: flex;
  gap: 12rpx;
}

.primary-small-button,
.secondary-button,
.error-card button {
  height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.primary-small-button {
  color: #fff;
  background: #1677e8;
}

.secondary-button {
  color: #1677e8;
  background: #eaf3ff;
}

.primary-small-button::after,
.secondary-button::after,
.error-card button::after {
  border: none;
}

.error-card {
  display: flex;
  flex-direction: column;
  color: #d64545;
  font-size: 26rpx;
}

.error-card button {
  align-self: flex-start;
  margin-top: 20rpx;
  color: #fff;
  background: #e05a5a;
}

.loading-state,
.empty-state {
  padding: 100rpx 0;
  color: #8a97a8;
  text-align: center;
  font-size: 26rpx;
}
